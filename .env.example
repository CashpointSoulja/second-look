# Pulled automatically with `vercel env pull .env.local` once the project is linked.
DATABASE_URL=            # Neon pooled URL (app runtime)
DATABASE_URL_UNPOOLED=   # Neon direct URL (migrations)
BLOB_READ_WRITE_TOKEN=   # Vercel Blob (arrival photo uploads)

# Vision AI via Vercel AI Gateway. On Vercel, OIDC auth is automatic; locally use either:
VERCEL_OIDC_TOKEN=       # from `vercel env pull`
AI_GATEWAY_API_KEY=      # or a Gateway API key
VISION_MODEL=google/gemini-3.5-flash   # optional override
# With no AI credentials the app still runs, using scripted demo verdicts.
